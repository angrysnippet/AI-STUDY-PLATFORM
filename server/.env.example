# Copy to .env and fill in real values when you have them.
# Any value left as a "your_..." placeholder keeps that integration in STUB mode,
# so the app runs fully without real keys.

PORT=4000
CLIENT_URL=http://localhost:5173

# --- AI agent (Claude) ---
ANTHROPIC_API_KEY=your_anthropic_api_key
# Default model; switch to claude-sonnet-4-6 for lower cost if you prefer.
ANTHROPIC_MODEL=claude-opus-4-8

# --- Database ---
MONGODB_URI=your_mongodb_atlas_uri

# --- Auth ---
JWT_SECRET=your_jwt_secret
# Local default is true. Set false on every public deployment.
DEV_LOGIN_ENABLED=true
GOOGLE_CLIENT_ID=your_google_client_id
# Not currently used: ID-token verification only needs GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_SECRET=your_google_client_secret

# --- YouTube ingest ---
YOUTUBE_API_KEY=your_youtube_data_api_key
